<!doctype html>
<html>
<head>
  <meta http-equiv="x-ua-compatible" content="IE=edge">
  <meta charset="utf-8">
  <title>NRO Admin Data</title>
  <hta:application
    id="NroAdminData"
    applicationname="NRO Admin Data"
    icon="C:\Users\PC\Music\Teamobi2026\SRC\assets\icons\admin_menu.ico"
    border="thin"
    caption="yes"
    maximizebutton="yes"
    minimizebutton="yes"
    scroll="no"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal" />
  <link rel="stylesheet" type="text/css" href="admin_data_menu/css/base.css">
  <link rel="stylesheet" type="text/css" href="admin_data_menu/css/layout.css">
  <link rel="stylesheet" type="text/css" href="admin_data_menu/css/components.css">
  <link rel="stylesheet" type="text/css" href="admin_data_menu/css/map-creator.css">
  <link rel="stylesheet" type="text/css" href="admin_data_menu/css/costume-creator.css">
  <link rel="stylesheet" type="text/css" href="admin_data_menu/css/responsive.css">
</head>
<body>
  <div id="app">
    <div id="sidebar">
      <h1>NRO Admin Data</h1>
      <div class="sub">Menu quản trị dữ liệu riêng</div>
      <button id="navItems" class="nav-button active" onclick="ShowTab('items')">Vật phẩm</button>
      <button id="navItemOptions" class="nav-button" onclick="ShowTab('itemoptions')">Option mặc định</button>
      <button id="navEvents" class="nav-button" onclick="ShowTab('events')">Sự kiện</button>
      <button id="navPlayerConfig" class="nav-button" onclick="ShowTab('playerconfig')">Cấu hình Player</button>
      <button id="navPetConfig" class="nav-button" onclick="ShowTab('petconfig')">Cấu hình Đệ tử</button>
      <button id="navSkillMastery" class="nav-button" onclick="ShowTab('skillmastery')">Quản lý Skill</button>
      <button id="navTaskConfig" class="nav-button" onclick="ShowTab('taskconfig')">Cấu hình Nhiệm vụ</button>
      <button id="navPlayers" class="nav-button" onclick="ShowTab('players')">Quản lý Player</button>
      <button id="navEquip" class="nav-button" onclick="ShowTab('equip')">Chỉ số TB</button>
      <button id="navCombine" class="nav-button" onclick="ShowTab('combine')">Nâng cấp/ Cường hóa</button>
      <button id="navRadar" class="nav-button" onclick="ShowTab('radar')">S&#7893; s&#432;u t&#7847;m</button>
      <button id="navGift" class="nav-button" onclick="ShowTab('gift')">Giftcode</button>
      <button id="navGiftBox" class="nav-button" onclick="ShowTab('giftbox')">Hộp quà / Rương</button>
      <button id="navBoss" class="nav-button" onclick="ShowTab('boss')">Boss</button>
      <button id="navMob" class="nav-button" onclick="ShowTab('mob')">Mob / Quái</button>
      <button id="navNpc" class="nav-button" onclick="ShowTab('npc')">NPC & Shop</button>
      <button id="navNpcCreator" class="nav-button" onclick="ShowTab('npccreator')">Tạo NPC</button>
      <button id="navCostumeCreator" class="nav-button" onclick="ShowTab('costumecreator')">Tạo Cải Trang</button>
      <button id="navMapCreator" class="nav-button" onclick="ShowTab('mapcreator')">Tạo Map</button>
      <button id="navAudit" class="nav-button" onclick="ShowTab('audit')">Lịch sử thay đổi</button>
      <div class="status-card" id="statusBox">Đang tải cấu hình...</div>
    </div>

    <div id="main">
      <div class="topbar">
        <div class="top-title" id="pageTitle">Vật phẩm</div>
        <div class="top-sub" id="pageSub">Lọc theo type, xem và sửa item template</div>
        <div class="top-actions">
          <button class="compact" onclick="RefreshCurrent()">Làm mới</button>
          <button class="compact primary" onclick="RestartServer()">Restart</button>
        </div>
      </div>

      <div id="tabViews"></div>

    </div>
  </div>
  <div id="toastContainer" class="toast-container"></div>

  <script language="JScript" charset="utf-8" src="admin_data_menu/js/core/runtime.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/core/utils.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/core/ui.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/core/registry.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/components/checklist.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/components/catalog.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/components/options.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/components/spawn.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/components/config.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/core/combos.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/items.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/item-options.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/events.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/combine.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/radar.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/equipment.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/giftcode.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/gift-boxes.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/boss.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/mob.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/shops.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/npc-creator.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/costume-creator.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/map-creator.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/player-config.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/pet-config.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/skill-mastery.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/task-config.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/players.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/tabs/audit.js"></script>
  <script language="JScript" charset="utf-8" src="admin_data_menu/js/core/app.js"></script>
</body>
</html>
