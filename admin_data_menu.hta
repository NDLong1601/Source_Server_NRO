                  <label>Đang bán</label>
                  <input id="shopIsSell" class="hidden-value" value="1">
                  <div id="combo_shopIsSell" class="combo" onclick="ToggleCombo('shopIsSell'); event.cancelBubble = true;">
                    <span id="combo_shopIsSell_text" class="combo-text">Bật</span>
                    <span class="combo-button"><span class="combo-caret"></span></span>
