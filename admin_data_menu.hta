                <div class="cell"><label>Option row</label><input id="shopOptionRowId"></div>
                <div class="cell">
                  <label>Option ID</label>
                  <input id="shopOptionId" class="hidden-value" value="">
                  <div id="combo_shopOptionId" class="combo" onclick="ToggleCombo('shopOptionId'); event.cancelBubble = true;">
                    <span id="combo_shopOptionId_text" class="combo-text">Chọn option</span>
